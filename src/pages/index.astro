---
import Layout from '../layouts/LayoutBase.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/foto.jpg';
---
<Layout title="Joan Mas Lloret">
    <main class="profile-layout">
        <div class="text-content">
            <h1>Hello! I'm Joan Mas Lloret</h1>

            <p>I am a software engineer, with a focus on DevOps and platform engineering.</p>

            <p>I graduated in biochemistry and biomedical science, but eventually self-taught my way into software engineering.<br />
            Lab material is now safe from my clumsy hands, and I like it here.<br />
            I am from València, Spain.</p>

            <p>
                <a href="/blog">Blog</a> · <a href="/cv">CV</a>
            </p>
        </div>

        <Image src={profilePic} alt="Joan Mas Lloret" class="photo" width={200} height={200} />
    </main>

    <style>
        html,
        body {
            margin: 0;
            width: 100%;
            height: 100%;
        }

        body {
            padding: 5rem 2rem 3rem; 
            box-sizing: border-box;
        }

        .profile-layout {
            display: flex;
            flex-direction: row; 
            align-items: flex-start; 
            gap: 2.5rem; 
            max-width: 900px;
            margin: 0 auto; 
        }

        .text-content {
            text-align: left;
            font-size: 1.125rem;
            max-width: 55ch; 
        }

        h1 {
            margin-top: 0; 
        }

        .photo {
            flex-shrink: 0;
            border-radius: 50%; 
            object-fit: cover; 
        }

        @media (max-width: 700px) {
            .profile-layout {
                flex-direction: column;
                align-items: center;
            }
            
            .text-content {
                text-align: center;
            }
        }
    </style>
</Layout>